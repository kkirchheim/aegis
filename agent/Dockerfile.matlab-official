ARG MATLAB_BASE_IMAGE=matlab-licensed-test:r2025b
FROM ${MATLAB_BASE_IMAGE}
ARG MATLAB_PRODUCTS=""

USER root

WORKDIR /app

RUN apt-get update && apt-get install -y \
    git \
    git-lfs \
    curl \
    build-essential \
    python3 \
    python3-pip \
    python3-venv \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Install MathWorks Package Manager for optional toolbox installation.
RUN curl -fsSL https://www.mathworks.com/mpm/glnxa64/mpm -o /usr/local/bin/mpm && \
    chmod +x /usr/local/bin/mpm

RUN if [ -n "$MATLAB_PRODUCTS" ]; then \
        mpm install \
            --release=R2025b \
            --destination=/opt/matlab/R2025b \
            --products=$MATLAB_PRODUCTS; \
    fi

# Put a MATLAB wrapper first on PATH so agent commands automatically use the
# online licensing mode that was activated in the committed base image.
RUN matlab_real_path="$(readlink -f "$(command -v matlab)")" && \
    rm -f /usr/local/bin/matlab && \
    printf '%s\n' \
        '#!/usr/bin/env bash' \
        'set -e' \
        'for arg in "$@"; do' \
        '  if [ "$arg" = "-licmode" ]; then' \
        "    exec \"$matlab_real_path\" \"\$@\"" \
        '  fi' \
        'done' \
        "exec \"$matlab_real_path\" -licmode onlinelicensing \"\$@\"" \
        > /usr/local/bin/matlab && \
    chmod +x /usr/local/bin/matlab

COPY agent/agent.py .

RUN mkdir -p /workspace/repo && \
    chown -R matlab:matlab /app /workspace

USER matlab

ENV VENV=/home/matlab/agent-venv
RUN python3 -m venv $VENV
ENV PATH="/usr/local/bin:$VENV/bin:$PATH"

RUN pip install --upgrade pip setuptools wheel && \
    pip install --no-cache-dir requests

WORKDIR /workspace

ENV PYTHONUNBUFFERED=1
ENTRYPOINT ["python", "/app/agent.py"]
