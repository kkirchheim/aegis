# Paper Reproducibility Checker - Environment Variables
# Copy this file to .env and fill in your configuration

# ============================================================================
# REQUIRED SECRETS
# ============================================================================

# Anthropic API Key (REQUIRED)
# Get it from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Flask Secret Key for Session Management (OPTIONAL)
# If not set, a new random key will be generated each time the app starts.
# For production, generate a secure key:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# SECRET_KEY=your-secure-secret-key-here

# ============================================================================
# LLM PROVIDER CONFIGURATION
# ============================================================================

# LLM Provider Selection
# Options: 'anthropic' (default) or 'ollama'
LLM_PROVIDER=anthropic

# Anthropic Claude Model
# Check available models at: https://console.anthropic.com/
# Examples: claude-opus-4-1, claude-3-5-sonnet-20241022, claude-3-5-haiku-20241022
# Default: claude-haiku-4-5
ANTHROPIC_MODEL=claude-haiku-4-5

# Ollama Configuration (if using Ollama as LLM provider)
# Base URL for Ollama service
# Default: http://localhost:11434 (local)
# Docker: http://ollama:11434 (if running in same network)
OLLAMA_BASE_URL=http://localhost:11434

# Ollama Model Name
# Default: llama2
OLLAMA_MODEL=llama2

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# Database Path
# Default: reproducibility.db (SQLite in current directory)
# Can be absolute path or relative to app root
DATABASE_PATH=reproducibility.db

# ============================================================================
# DOCKER CONFIGURATION
# ============================================================================

# Docker Network Name
# Used for spawning agent containers that need to communicate with the backend
# Default: workspace_traefik
DOCKER_NETWORK=workspace_traefik

# Docker Backend URL
# URL that agent containers use to reach the backend Flask app
# For Docker-in-Docker: http://paper-reproducibility:5000 (service name)
# For local development: http://host.docker.internal:5000
# Default: http://paper-reproducibility:5000
DOCKER_BACKEND_URL=http://paper-reproducibility:5000

# ============================================================================
# FLASK SERVER CONFIGURATION
# ============================================================================

# Flask Environment
# Options: 'development' (default) or 'production'
FLASK_ENV=development

# Flask Debug Mode
# Only enable in development! Disables in production.
# Options: 1 (enabled) or 0 (disabled)
FLASK_DEBUG=1

# Flask Host Binding
# 0.0.0.0 = accept connections from any interface
# 127.0.0.1 = localhost only
FLASK_HOST=0.0.0.0

# Flask Port
# Default: 5000
FLASK_PORT=5000

# Backend URL for Frontend
# URL that the frontend uses to reach the backend API
# For Docker: http://host.docker.internal:5000 (from Docker desktop container)
# For local: http://localhost:5000
BACKEND_URL=http://localhost:5000

# ============================================================================
# AGENT CONFIGURATION
# ============================================================================

# Agent Context Limit (characters)
# Maximum number of characters of the last command output to include in agent prompts
# Increase this if the agent needs more context to avoid decision loops
# Default: 10000
AGENT_CONTEXT_LIMIT=10000

# ============================================================================
# CACHING CONFIGURATION
# ============================================================================

# Enable Result Caching
# When enabled, analysis results for the same paper are reused
# Options: 'true' (enabled) or 'false' (disabled, default)
# Warning: When enabled, duplicate papers may return stale results
ENABLE_CACHING=false

# ============================================================================
# NOTES
# ============================================================================
# 
# For Docker deployments:
# - Keep DOCKER_BACKEND_URL = http://paper-reproducibility:5000
# - Keep DOCKER_NETWORK = workspace_traefik (or your Docker network name)
# - Keep DATABASE_PATH = reproducibility.db (will be in app directory)
#
# For local development:
# - Change DOCKER_BACKEND_URL = http://host.docker.internal:5000
# - Change BACKEND_URL = http://localhost:5000
# - Use ANTHROPIC_API_KEY from your Anthropic Console
#
# For production:
# - Set FLASK_ENV=production
# - Set FLASK_DEBUG=0
# - Generate a secure SECRET_KEY and add it here
# - Use strong ANTHROPIC_API_KEY
# - Consider using a managed database instead of SQLite
#
