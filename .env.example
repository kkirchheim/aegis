# Paper Reproducibility Checker - Environment Variables

# Required: Anthropic API Key
# Get it from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: Claude Model
# Check your account at https://console.anthropic.com for available models
# Examples: claude-opus-4-1, claude-3-5-sonnet-20241022, claude-3-5-haiku-20241022
# Default: claude-opus-4-1
CLAUDE_MODEL=claude-opus-4-1

# Optional: Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=1

# Optional: Server Configuration
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# Optional: Backend URL for Agent
# Leave as-is for Docker, change for local development
BACKEND_URL=http://host.docker.internal:5000
